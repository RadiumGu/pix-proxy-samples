<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

    <modelVersion>4.0.0</modelVersion>
    <artifactId>pix-proxy-test</artifactId>
    <packaging>jar</packaging>

    <name>PIX Proxy Test</name>

    <parent>
        <groupId>com.amazon.aws</groupId>
        <artifactId>pix</artifactId>
        <version>1.0.0</version>
    </parent>

    <dependencies>
        <dependency>
            <groupId>com.amazon.aws</groupId>
            <artifactId>pix-core</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>

        <dependency>
            <groupId>org.apache.camel.quarkus</groupId>
            <artifactId>camel-quarkus-netty-http</artifactId>
        </dependency>

        <!--
          Both architectures, deliberately. Declaring only one means the runner jar carries one
          architecture's native library and the application fails at STARTUP on the other with
          UnsatisfiedLinkError: could not load a native library: netty_transport_native_epoll_<arch>.
          Measured on an aarch64 host: identical failure on JDK 11 and JDK 17, so it is the pin and
          not the JDK. Both classifiers are published at the Netty version pinned in the parent.
        -->
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-transport-native-epoll</artifactId>
            <classifier>linux-x86_64</classifier>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-transport-native-epoll</artifactId>
            <classifier>linux-aarch_64</classifier>
        </dependency>

        <dependency>
            <groupId>commons-io</groupId>
            <artifactId>commons-io</artifactId>
        </dependency>

        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>ssm</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>software.amazon.awssdk</groupId>
                    <artifactId>netty-nio-client</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>software.amazon.awssdk</groupId>
                    <artifactId>apache-client</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>url-connection-client</artifactId>
        </dependency>

        <!--
          Test scope only. The BCB DICT v2 transparent-proxy contract test drives real
          camel-netty-http routes over plain HTTP, so it needs a test runner here; version is
          managed by the parent pom. Nothing in src/main gains a dependency from this.
        -->
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
          Test scope only. Camel 3 ships each component as its own artifact, so "direct:" is not
          on the classpath just because camel-core is - a route using it fails at startup with
          "No endpoint could be found". The onCompletion audit test needs a trivial in-process
          consumer so that the transport failure it provokes comes from the PRODUCER leg and
          nothing else; netty-http would put a second network hop in front of the behaviour under
          test. Version is managed by the camel-quarkus BOM in the parent pom. src/main gains
          nothing from this.
        -->
        <dependency>
            <groupId>org.apache.camel</groupId>
            <artifactId>camel-direct</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
          Test scope only. Brings in core's committed certificate fixtures (security/client.jks and
          friends) so the Netty TLS tests here can use the SAME fixtures the core tests use, rather
          than a duplicated copy. proxy/test had no test resources of its own, which is why the first
          version of NettyHostnameVerificationTest failed: the keystore was simply not on this
          module's classpath, so the fixture server had no usable key and answered handshake_failure -
          which looked like a TLS defect and was a classpath problem.
        -->
        <dependency>
            <groupId>com.amazon.aws</groupId>
            <artifactId>pix-core</artifactId>
            <version>1.0.0</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>

        <!--
          Test scope only, and it is what makes the TLS tests cover the provider production actually
          uses. The production module pins netty-tcnative with the linux-x86_64-fedora classifier, so
          OpenSsl.isAvailable() is false anywhere else - including an aarch64 build host - and the
          Netty TLS test would silently fall back to SslProvider.JDK while appearing to cover OpenSSL.
          The boringssl-static artifact bundles natives for several architectures, so the same engine
          code production runs (ReferenceCountedOpenSslEngine) is exercised here. Version comes from
          the parent's netty-tcnative pin; nothing in src/main gains a dependency.
        -->
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-tcnative-boringssl-static</artifactId>
            <version>${netty-tcnative.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>io.quarkus</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <configuration>
                    <debug>5006</debug>
                </configuration>
            </plugin>

            <!--
              Not installed into the local repository, deliberately - same reason as
              proxy/cloudhsm/proxy.

              Quarkus 2.x renames the jar plugin's output to *.jar.original when building an uber-jar,
              leaving no main artifact, so `mvn install` fails with "did not assign a main file to the
              project but it has attachments". Measured on 2.13.9.Final.

              This is the BCB simulator - a deployable application, and nothing in the reactor depends
              on it (checked across every pom, not assumed). A local-repository copy would have no
              consumer; the artifact that matters is pix-proxy-test-1.0.0-runner.jar in target/, which
              keeps the name the docker-compose setup and the JDK-17 startup measurements refer to.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-install-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
