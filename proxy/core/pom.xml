<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

	<modelVersion>4.0.0</modelVersion>
	<artifactId>pix-core</artifactId>
	<packaging>jar</packaging>

	<name>AWS PIX Core</name>

	<parent>
		<groupId>com.amazon.aws</groupId>
		<artifactId>pix</artifactId>
		<version>1.0.0</version>
	</parent>

	<dependencies>
		<dependency>
			<groupId>org.json</groupId>
			<artifactId>json</artifactId>
			<version>20231013</version>
		</dependency>

		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-api</artifactId>
		</dependency>

		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
		</dependency>

		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<scope>test</scope>
		</dependency>

		<dependency>
			<groupId>commons-io</groupId>
			<artifactId>commons-io</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
            <!--
              Publishes the test classes and test RESOURCES as a test-jar so proxy/test can reuse the
              committed certificate fixtures. The alternative was copying security/client.jks into a
              second module, which would give the repository two sources of truth for a fixture that
              WellKnownTestCertificatesTest fingerprints by design.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.2.0</version>
                <executions>
                    <execution>
                        <id>publish-test-jar</id>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
			<plugin>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<compilerArgs>
						<arg>--add-exports</arg>
						<arg>java.xml.crypto/com.sun.org.apache.xml.internal.security.signature=ALL-UNNAMED</arg>
						<arg>--add-exports</arg>
						<arg>java.xml.crypto/org.jcp.xml.dsig.internal.dom=ALL-UNNAMED</arg>
					</compilerArgs>
				</configuration>
			</plugin>

			<!--
			  The SAME exports the compiler needs, given to the test JVM as well.

			  They were declared for compilation only, which compiles fine and then throws at RUNTIME on
			  JDK 17 - measured: three signing tests fail with

			    IllegalAccessError: class Iso20022URIDereferencer cannot access class
			    com.sun.org.apache.xml.internal.security.signature.XMLSignatureInput (in module
			    java.xml.crypto)

			  On JDK 11 the tests pass without these flags because that release still permitted the
			  reflective access; from JDK 17 strong encapsulation denies it and the escape hatch is gone.
			  So a compile-only declaration made the build look ready for JDK 17 while every signing path
			  was broken on it.

			  They are passed unconditionally rather than behind a JDK profile: on JDK 11 an unknown
			  add-exports option for an existing module is accepted and ignored, so one configuration serves
			  both, and there is no profile to forget to activate.

			  Anything that RUNS this code needs the same flags - see the Dockerfile and
			  README-CloudHSM.md. A jar that compiles is not a jar that runs.
			-->
			<plugin>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<argLine>--add-exports java.xml.crypto/com.sun.org.apache.xml.internal.security.signature=ALL-UNNAMED --add-exports java.xml.crypto/org.jcp.xml.dsig.internal.dom=ALL-UNNAMED</argLine>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
