<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

    <modelVersion>4.0.0</modelVersion>
    <artifactId>pix-cloudhsm-proxy</artifactId>
    <packaging>jar</packaging>

    <name>PIX CloudHSM Proxy</name>

    <parent>
        <groupId>com.amazon.aws</groupId>
        <artifactId>pix-cloudhsm</artifactId>
        <version>1.0.0</version>
    </parent>

    <dependencies>
        <dependency>
            <groupId>com.amazon.aws</groupId>
            <artifactId>pix-core</artifactId>
        </dependency>

        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>secretsmanager</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>software.amazon.awssdk</groupId>
                    <artifactId>netty-nio-client</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>software.amazon.awssdk</groupId>
                    <artifactId>apache-client</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>ssm</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>software.amazon.awssdk</groupId>
                    <artifactId>netty-nio-client</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>software.amazon.awssdk</groupId>
                    <artifactId>apache-client</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>firehose</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>software.amazon.awssdk</groupId>
                    <artifactId>netty-nio-client</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>software.amazon.awssdk</groupId>
                    <artifactId>apache-client</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>url-connection-client</artifactId>
        </dependency>

        <dependency>
            <groupId>com.cavium</groupId>
            <artifactId>cloudhsm</artifactId>
            <!--
              Was [3.0.0,) - an open range, so the build compiled against whatever version the
              mutable "latest" rpm happened to contain, and Maven would pick up a newer one
              silently. The rpm is now pinned in the parent pom, which makes the version knowable,
              so the range is closed to an exact value. A mismatch between the pinned rpm and this
              version fails the build instead of being absorbed.
            -->
            <version>${cloudhsm.sdk3.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <version>2.17.1</version>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>

        <dependency>
            <groupId>org.apache.camel.quarkus</groupId>
            <artifactId>camel-quarkus-netty-http</artifactId>
        </dependency>

        <!--
          Both architectures, deliberately. Declaring only one means the runner jar carries one
          architecture's native library and the application fails at STARTUP on the other with
          UnsatisfiedLinkError: could not load a native library: netty_transport_native_epoll_<arch>.
          Measured on an aarch64 host: identical failure on JDK 11 and JDK 17, so it is the pin and
          not the JDK. Both classifiers are published at the Netty version pinned in the parent.
        -->
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-transport-native-epoll</artifactId>
            <classifier>linux-x86_64</classifier>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-transport-native-epoll</artifactId>
            <classifier>linux-aarch_64</classifier>
        </dependency>

        <!--
          netty-tcnative, BOTH architectures.

          No version on either: a version declared in a module's own <dependencies> beats
          dependencyManagement outright, so hardcoding it here silently defeated the parent's security
          override - measured, the parent moved Netty to 4.1.118 while tcnative stayed on 2.0.31 until
          the line was removed. The version comes from the parent so the pair cannot drift apart.

          The aarch64 classifier is 'linux-aarch_64-FEDORA', and the asymmetry with the x86_64 row is
          real rather than a typo. Measured against Maven Central at 2.0.84.Final:

            linux-x86_64          published
            linux-x86_64-fedora   published
            linux-aarch_64        NOT PUBLISHED
            linux-aarch_64-fedora published

          So aarch64 has only the fedora flavour. netty-tcnative is the openssl-DYNAMIC build, linked
          against the host's OpenSSL, which is why flavours exist at all; the -fedora build targets the
          OpenSSL soname shipped by RHEL-family distributions, which is what this image is built on.

          READ THIS BEFORE RELYING ON tcnative FOR THE BCB mTLS KEY: it cannot carry one. OpenSSL needs
          the key BYTES - Netty's OpenSslKeyMaterialProvider calls toBIO(key) then
          SSL.parsePrivateKey() for any key that is not already an OpenSslPrivateKey - and an HSM key's
          getEncoded() is null. The client leg therefore uses SslProvider.JDK with HsmX509KeyManager.
          These artifacts remain for the server-side listeners, where the key is a local file.
        -->
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-tcnative</artifactId>
            <classifier>linux-x86_64-fedora</classifier>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-tcnative</artifactId>
            <classifier>linux-aarch_64-fedora</classifier>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>io.quarkus</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
